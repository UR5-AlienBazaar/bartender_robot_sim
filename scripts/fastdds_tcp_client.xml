<?xml version="1.0" encoding="UTF-8" ?>
<!-- FastDDS TCP CLIENT profile: used on the laptop. Connects out to the Pi's
     FastDDS TCP server at 10.42.0.200:4212. Port 7400 is the default logical
     metatraffic port for ROS domain 0 in Fast DDS. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>tcp_client</transport_id>
      <type>TCPv4</type>
      <sendBufferSize>16777216</sendBufferSize>
      <receiveBufferSize>16777216</receiveBufferSize>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>shm</transport_id>
      <type>SHM</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="laptop" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>tcp_client</transport_id><transport_id>shm</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
      <builtin>
        <initialPeersList>
          <locator>
            <tcpv4>
              <address>10.42.0.200</address>
              <physical_port>4212</physical_port>
              <port>7400</port>
            </tcpv4>
          </locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
</profiles>
